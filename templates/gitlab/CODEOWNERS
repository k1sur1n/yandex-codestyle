# Шаблон CODEOWNERS для GitLab - перенос на GitLab - не Яндекс.
# Яндекс не публикует GitLab-шаблонов; это перенос файла templates/github/CODEOWNERS
# (профиль Яндекса, реконструкция, см. docs/git/repository.md: Y-REPO-013).
#
# Отличия от GitHub:
# - GitLab ищет файл в корне, затем в `docs/`, затем в `.gitlab/` и берёт первый найденный.
# - Есть секции `[Имя]`: в каждой секции действует последняя совпавшая строка, а одобрение нужно
#   от каждой затронутой секции. Так выражается правило «одобрение всех вызванных владельцев».
# - `[Имя][2]` требует два одобрения от секции; `^[Имя]` делает секцию необязательной;
#   владельцы в строке заголовка секции действуют по умолчанию для её путей.
# - Обязательность одобрения включается в защищённой ветке («Require approval from code owners»)
#   и доступна только на тарифах Premium и Ultimate (документация GitLab помечает Code Owners
#   «Tier: Premium, Ultimate»; поведение файла на Free в ней не описано).
# Замените метки в угловых скобках.

# Владельцы по умолчанию: мейнтейнеры проекта.
* @<GROUP>/<MAINTAINERS>

# Владельцы компонентов.
[Components]
/src/<component>/ @<GROUP>/<COMPONENT_TEAM>
/src/<module>/ @<user1> @<user2>

# Документация: владельцы заданы в заголовке секции и действуют для всех её путей.
[Docs] @<GROUP>/<DOCS_TEAM>
/docs/
*.md

# CI: изменения конвейера одобряют двое.
[CI][2] @<GROUP>/<CI_TEAM>
/.gitlab-ci.yml
/.gitlab/

# Релизные файлы: секция необязательная, чтобы релизный MR мог одобрить любой участник
# (перенос приёма из gravity-ui/page-constructor, где эти файлы оставлены без владельца).
^[Release files]
/package.json @<GROUP>/<MAINTAINERS>
/package-lock.json @<GROUP>/<MAINTAINERS>
/CHANGELOG.md @<GROUP>/<MAINTAINERS>
